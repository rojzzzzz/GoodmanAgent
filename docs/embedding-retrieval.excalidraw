    {
      "id": "search_sql_code",
      "type": "text",
      "x": 104,
      "y": 1548,
      "width": 1172,
      "height": 330,
      "text": "SELECT n.id, n.text, n.source_label,\n       i.titulo, i.numero, i.url,\n       i.fecha_aprobacion, i.fecha_publicacion,\n       n.embedding <=> %(q)s::vector AS distance\nFROM document_nodes AS n\nJOIN legal_instruments AS i\n  ON i.id = n.legal_instrument_id\nWHERE n.node_type = 'article'\n  AND i.extraction_status = 'ok'\n  AND n.embedding IS NOT NULL\nORDER BY n.embedding <=> %(q)s::vector\nLIMIT %(k)s;",
      "originalText": "SELECT n.id, n.text, n.source_label,\n       i.titulo, i.numero, i.url,\n       i.fecha_aprobacion, i.fecha_publicacion,\n       n.embedding <=> %(q)s::vector AS distance\nFROM document_nodes AS n\nJOIN legal_instruments AS i\n  ON i.id = n.legal_instrument_id\nWHERE n.node_type = 'article'\n  AND i.extraction_status = 'ok'\n  AND n.embedding IS NOT NULL\nORDER BY n.embedding <=> %(q)s::vector\nLIMIT %(k)s;",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 400005,
      "version": 1,
      "versionNonce": 400105,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null
    },
    {
      "id": "search_sql_notes",
      "type": "text",
      "x": 80,
      "y": 1942,
      "width": 1220,
      "height": 85,
      "text": "q = query vector; k = result count. Lower distance ranks first.\nDates and source URLs stay structured.\nSimilarity does not establish legal effect or verified vigencia.",
      "originalText": "q = query vector; k = result count. Lower distance ranks first.\nDates and source URLs stay structured.\nSimilarity does not establish legal effect or verified vigencia.",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.5,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
