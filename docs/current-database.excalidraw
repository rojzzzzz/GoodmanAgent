    {"id":"query_sql","type":"text","x":104,"y":1890,"width":1070,"height":230,"text":"SELECT n.id, n.node_key, n.source_label, n.text,\n       i.titulo, i.numero, i.fecha_aprobacion,\n       i.fecha_publicacion, i.url\nFROM public.document_nodes AS n\nJOIN public.legal_instruments AS i\n  ON i.id = n.legal_instrument_id\nWHERE n.node_type = 'article'\n  AND i.extraction_status = 'ok';","originalText":"SELECT n.id, n.node_key, n.source_label, n.text,\n       i.titulo, i.numero, i.fecha_aprobacion,\n       i.fecha_publicacion, i.url\nFROM public.document_nodes AS n\nJOIN public.legal_instruments AS i\n  ON i.id = n.legal_instrument_id\nWHERE n.node_type = 'article'\n  AND i.extraction_status = 'ok';","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.4,"strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300006,"version":1,"versionNonce":300106,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
